# Git internals from nested repos
**/.git/

# Dependencies
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / secrets
**/.env
**/.env.*
!**/.env.template

# SSL / certificates / keys
**/cert.pem
**/key.pem
**/*.pem
**/*.key
**/*.crt

# Coturn real config - may contain secrets
coturn/turnserver.conf
mirotalk/mirotalk/coturn/turnserver.conf

# Logs
**/logs/
**/*.log

# Backups
**/backup-*/
**/*.backup*
**/*.bak
**/*.old

# Disabled temporary files
**/*.disabled-*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Generated tree file
folder-tree.txt

# Avoid committing duplicate outer MiruTalk copy
mirotalk/*
!mirotalk/mirotalk/
!mirotalk/mirotalk/**

# Backups inside MiruTalk
**/backup-*/
**/backup-*

# Logs
**/*.log

# Secrets / runtime
**/.env
**/.env.*
!**/.env.template
**/cert.pem
**/key.pem
**/*.pem
**/*.key