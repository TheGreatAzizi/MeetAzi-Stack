/* Meetazi chat UI fix - safe CSS only */

#msgerDraggable,
.msgerDraggable,
#msger,
.msger,
#chatRoom,
.chatRoom,
#chat {
  font-family: Vazirmatn, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
}

#msgerDraggable,
.msgerDraggable {
  border-radius: 22px !important;
  overflow: hidden !important;
  border: 1px solid rgba(255, 255, 255, 0.14) !important;
  box-shadow: 0 24px 70px rgba(0, 0, 0, 0.42) !important;
  backdrop-filter: blur(18px) !important;
  -webkit-backdrop-filter: blur(18px) !important;
}

.msger,
#msger {
  background: rgba(15, 23, 42, 0.94) !important;
  color: #f8fafc !important;
  border-radius: 22px !important;
  overflow: hidden !important;
}

.msger-header,
#msgerHeader,
.chat-header,
#chatHeader {
  min-height: 58px !important;
  padding: 14px 16px !important;
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.22), rgba(236, 72, 153, 0.16)) !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.12) !important;
  color: #ffffff !important;
  display: flex !important;
  align-items: center !important;
  gap: 10px !important;
}

.msger-header-title,
#msgerHeaderTitle,
.chat-header-title {
  font-size: 15px !important;
  font-weight: 800 !important;
  letter-spacing: -0.01em !important;
}

.msger-chat,
#msgerChat,
.chat-messages,
#chatMessages {
  padding: 18px 14px !important;
  background:
    radial-gradient(circle at 20% 0%, rgba(245, 158, 11, 0.10), transparent 34%),
    radial-gradient(circle at 80% 20%, rgba(236, 72, 153, 0.09), transparent 30%),
    rgba(2, 6, 23, 0.72) !important;
  scrollbar-width: thin !important;
  scrollbar-color: rgba(245, 158, 11, 0.7) rgba(255, 255, 255, 0.06) !important;
}

.msger-chat::-webkit-scrollbar,
#msgerChat::-webkit-scrollbar,
.chat-messages::-webkit-scrollbar {
  width: 8px !important;
}

.msger-chat::-webkit-scrollbar-track,
#msgerChat::-webkit-scrollbar-track,
.chat-messages::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.06) !important;
  border-radius: 999px !important;
}

.msger-chat::-webkit-scrollbar-thumb,
#msgerChat::-webkit-scrollbar-thumb,
.chat-messages::-webkit-scrollbar-thumb {
  background: rgba(245, 158, 11, 0.75) !important;
  border-radius: 999px !important;
}

.msg {
  display: flex !important;
  align-items: flex-end !important;
  gap: 10px !important;
  margin: 12px 0 !important;
}

.msg-img {
  width: 34px !important;
  height: 34px !important;
  border-radius: 14px !important;
  flex: 0 0 34px !important;
  border: 2px solid rgba(255, 255, 255, 0.16) !important;
  background-color: rgba(255, 255, 255, 0.12) !important;
  background-size: cover !important;
  background-position: center !important;
}

.msg-bubble {
  max-width: min(78%, 520px) !important;
  padding: 10px 12px !important;
  border-radius: 18px !important;
  line-height: 1.8 !important;
  font-size: 14px !important;
  word-break: break-word !important;
  overflow-wrap: anywhere !important;
  border: 1px solid rgba(255, 255, 255, 0.10) !important;
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.20) !important;
}

.left-msg .msg-bubble {
  background: rgba(255, 255, 255, 0.10) !important;
  color: #f8fafc !important;
  border-bottom-right-radius: 6px !important;
}

.right-msg {
  flex-direction: row-reverse !important;
}

.right-msg .msg-bubble {
  background: linear-gradient(135deg, #f59e0b, #ec4899) !important;
  color: #111827 !important;
  border-bottom-left-radius: 6px !important;
  font-weight: 600 !important;
}

.msg-info {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 10px !important;
  margin-bottom: 4px !important;
  color: rgba(248, 250, 252, 0.72) !important;
  font-size: 11px !important;
}

.right-msg .msg-info {
  color: rgba(17, 24, 39, 0.72) !important;
}

.msg-info-name {
  font-weight: 800 !important;
}

.msg-info-time {
  opacity: 0.72 !important;
  direction: ltr !important;
  font-size: 10px !important;
}

.msg-text,
.message-text {
  color: inherit !important;
  white-space: pre-wrap !important;
}

.msger-inputarea,
#msgerInputArea,
.chat-input-area,
#chatInputArea {
  display: flex !important;
  align-items: center !important;
  gap: 10px !important;
  padding: 12px !important;
  background: rgba(15, 23, 42, 0.96) !important;
  border-top: 1px solid rgba(255, 255, 255, 0.12) !important;
}

.msger-input,
#msgerInput,
.chat-input,
#chatInput,
textarea[id*="chat" i],
input[id*="chat" i] {
  min-height: 44px !important;
  max-height: 120px !important;
  flex: 1 1 auto !important;
  padding: 11px 14px !important;
  border-radius: 16px !important;
  border: 1px solid rgba(255, 255, 255, 0.12) !important;
  outline: none !important;
  background: rgba(255, 255, 255, 0.09) !important;
  color: #ffffff !important;
  font-family: inherit !important;
  font-size: 14px !important;
  line-height: 1.7 !important;
  resize: none !important;
}

.msger-input::placeholder,
#msgerInput::placeholder,
.chat-input::placeholder,
#chatInput::placeholder {
  color: rgba(255, 255, 255, 0.46) !important;
}

.msger-input:focus,
#msgerInput:focus,
.chat-input:focus,
#chatInput:focus {
  border-color: rgba(245, 158, 11, 0.82) !important;
  box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.15) !important;
}

.msger-send-btn,
#msgerSendBtn,
.chat-send-btn,
#chatSendBtn,
button[id*="send" i][id*="chat" i] {
  min-width: 44px !important;
  height: 44px !important;
  padding: 0 16px !important;
  border: 0 !important;
  border-radius: 16px !important;
  background: linear-gradient(135deg, #f59e0b, #ec4899) !important;
  color: #111827 !important;
  font-weight: 900 !important;
  cursor: pointer !important;
  box-shadow: 0 10px 22px rgba(245, 158, 11, 0.20) !important;
  transition: transform 0.18s ease, box-shadow 0.18s ease, opacity 0.18s ease !important;
}

.msger-send-btn:hover,
#msgerSendBtn:hover,
.chat-send-btn:hover,
#chatSendBtn:hover {
  transform: translateY(-1px) !important;
  box-shadow: 0 14px 30px rgba(236, 72, 153, 0.26) !important;
}

.msger-send-btn:active,
#msgerSendBtn:active,
.chat-send-btn:active,
#chatSendBtn:active {
  transform: translateY(1px) scale(0.98) !important;
}

button[id*="emoji" i],
button[class*="emoji" i],
button[id*="private" i],
button[class*="private" i] {
  border-radius: 14px !important;
}

@media (max-width: 760px) {
  #msgerDraggable,
  .msgerDraggable,
  #msger,
  .msger {
    width: calc(100vw - 18px) !important;
    max-width: calc(100vw - 18px) !important;
    max-height: calc(100vh - 92px) !important;
    border-radius: 20px !important;
  }

  .msger-chat,
  #msgerChat,
  .chat-messages,
  #chatMessages {
    padding: 14px 10px !important;
  }

  .msg-bubble {
    max-width: 84% !important;
    font-size: 13.5px !important;
  }

  .msger-inputarea,
  #msgerInputArea,
  .chat-input-area,
  #chatInputArea {
    padding: 10px !important;
    gap: 8px !important;
  }

  .msger-input,
  #msgerInput,
  .chat-input,
  #chatInput {
    min-height: 42px !important;
    font-size: 13.5px !important;
  }

  .msger-send-btn,
  #msgerSendBtn,
  .chat-send-btn,
  #chatSendBtn {
    height: 42px !important;
    min-width: 42px !important;
    padding: 0 13px !important;
  }
}
